<Window x:Class="ScreenSub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenSub.Desktop.ViewModels"
        xmlns:enums="clr-namespace:ScreenSub.Core.Enums;assembly=ScreenSub.Core"
        mc:Ignorable="d"
        Title="ScreenSub AI — Realtime Subtitle Translator"
        Height="840" Width="1380"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="44" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <Border Grid.Row="0" Background="#121522" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Purple Play Logo Icon -->
                    <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0" />
                                <GradientStop Color="#6366F1" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="▶" Foreground="#FFFFFF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </Border>

                    <TextBlock Text="ScreenSub AI" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center" />

                    <!-- MVP Badge -->
                    <Border Background="#252445" BorderBrush="#6366F1" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,10,0" VerticalAlignment="Center">
                        <TextBlock Text="MVP" FontSize="10" FontWeight="Bold" Foreground="#A5B4FC" />
                    </Border>

                    <TextBlock Text="Dịch phụ đề màn hình realtime • Anh - Trung - Việt" Foreground="{StaticResource TextMuted}" FontSize="12" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Control Buttons (Min, Max, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Width="44" Height="36" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Click="OnMinimizeClick" Cursor="Hand">
                        <TextBlock Text="—" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="44" Height="36" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Click="OnMaximizeClick" Cursor="Hand">
                        <TextBlock Text="▢" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button Width="44" Height="36" Background="Transparent" BorderThickness="0" Foreground="#94A3B8" Click="OnCloseClick" Cursor="Hand">
                        <TextBlock Text="✕" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="220" />
                <!-- Content View -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
                <Grid Margin="12,16,12,16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Nav Buttons -->
                    <StackPanel Grid.Row="0">
                        <!-- Dashboard Button -->
                        <Border CornerRadius="10" Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="Dashboard">
                                            <Setter Property="Background" Value="{StaticResource AccentPurple}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Background="Transparent" BorderThickness="0" Foreground="#FFFFFF"
                                    Height="42" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Dashboard" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Screen Capture -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                Height="40" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Chụp màn hình" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Translation -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                Height="40" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Dịch thuật" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Overlay Settings -->
                        <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                Height="40" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand" Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗂" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Cài đặt Overlay" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Settings -->
                        <Border CornerRadius="10" Margin="0,0,0,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                            <Setter Property="Background" Value="{StaticResource AccentPurple}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Command="{Binding NavigateCommand}" CommandParameter="Settings"
                                    Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextSecondary}"
                                    Height="40" HorizontalContentAlignment="Left" Padding="14,0" Cursor="Hand">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cài đặt" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                    </StackPanel>

                    <!-- Bottom Status Card -->
                    <Border Grid.Row="1" Background="#161A2B" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="12" Padding="14,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="Đang hoạt động" Foreground="{StaticResource AccentGreen}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Margin="0,2">
                                <TextBlock Text="OCR: PaddleOCR" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="✓" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="Dịch: Azure Translator" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="✓" Foreground="{StaticResource AccentGreen}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{Binding AverageLatencyMs, StringFormat='Độ trễ (TB): {0} ms'}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="📊" HorizontalAlignment="Right" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT VIEW ================= -->
            <Grid Grid.Column="1" Margin="22,18,22,18">
                <Grid.RowDefinitions>
                    <!-- Header with Title & Top 3 Badges -->
                    <RowDefinition Height="Auto" />
                    <!-- 3 Column Content Area -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Row -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Dashboard" FontSize="24" FontWeight="Bold" Foreground="#FFFFFF" />
                        <TextBlock Text="Theo dõi, dịch và hiển thị phụ đề từ bất kỳ nội dung nào trên màn hình." Foreground="{StaticResource TextSecondary}" FontSize="13.5" Margin="0,4,0,0" />
                    </StackPanel>

                    <!-- Top 3 Status Badges -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- OCR Badge -->
                        <Border Background="#161A2B" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" Background="#22283E" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="🖥" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="OCR" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreen}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding OcrStatusText}" Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Translation Badge -->
                        <Border Background="#161A2B" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" Background="#22283E" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="文" Foreground="#A5B4FC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Dịch thuật" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreen}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding TranslationStatusText}" Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="SemiBold" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Latency Badge -->
                        <Border Background="#161A2B" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="26" Height="26" Background="#22283E" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="⏱" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Độ trễ (TB)" Foreground="{StaticResource TextSecondary}" FontSize="11" />
                                    <TextBlock Text="{Binding AverageLatencyMs, StringFormat='≈ {0} ms'}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ================= 3 COLUMN DASHBOARD LAYOUT ================= -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid.ColumnDefinitions>
                        <!-- Left Panel: Quick Controls (Width 325) -->
                        <ColumnDefinition Width="325" />
                        <!-- Center Panel: Live Preview & Results (*) -->
                        <ColumnDefinition Width="*" />
                        <!-- Right Panel: Overlay Settings (Width 305) -->
                        <ColumnDefinition Width="305" />
                    </Grid.ColumnDefinitions>

                    <!-- ================= LEFT PANEL: QUICK CONTROLS ================= -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,14,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="⚡ Điều khiển nhanh" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                <!-- Action Buttons: Start, Pause, Stop -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.5*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Start Button (Green) -->
                                    <Button Grid.Column="0" Command="{Binding StartTranslationCommand}"
                                            Style="{StaticResource RoundedButton}"
                                            Background="{StaticResource AccentGreen}" BorderThickness="0"
                                            Height="36" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="▶" Foreground="#FFFFFF" FontSize="11" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Bắt đầu dịch" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Pause Button -->
                                    <Button Grid.Column="1" Command="{Binding PauseTranslationCommand}"
                                            Style="{StaticResource RoundedButton}"
                                            Background="#1E2438" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                            Height="36" Margin="0,0,6,0">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⏸" Foreground="#CBD5E1" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Tạm dừng" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Stop Button -->
                                    <Button Grid.Column="2" Command="{Binding StopTranslationCommand}"
                                            Style="{StaticResource RoundedButton}"
                                            Background="#1E2438" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                            Height="36">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⏹" Foreground="#CBD5E1" FontSize="10" Margin="0,0,4,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Dừng" Foreground="#CBD5E1" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>

                                <!-- Nguồn Chụp -->
                                <TextBlock Text="Nguồn chụp" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="1" Margin="0,0,0,8">
                                    <ComboBoxItem Content="🖥 Cửa sổ ứng dụng" />
                                    <ComboBoxItem Content="🌐 Toàn màn hình" />
                                </ComboBox>

                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBox}"
                                              ItemsSource="{Binding OpenWindows}"
                                              SelectedItem="{Binding SelectedWindow}"
                                              DisplayMemberPath="DisplayText" />
                                    <Button Grid.Column="1" Command="{Binding RefreshWindowsCommand}"
                                            Style="{StaticResource RoundedButton}"
                                            Background="#1E2438" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                            Width="32" Height="34" Margin="6,0,0,0" ToolTip="Làm mới danh sách cửa sổ">
                                        <TextBlock Text="🔄" FontSize="12" />
                                    </Button>
                                </Grid>

                                <!-- Chế độ vùng dịch (Radio Buttons) -->
                                <TextBlock Text="Chế độ vùng dịch ⓘ" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" />
                                <StackPanel Margin="0,0,0,14">
                                    <RadioButton Style="{StaticResource ModernRadioButton}" Content="Vùng cố định (Fixed Region)"
                                                 IsChecked="{Binding IsFixedRegionMode, Mode=TwoWay}" Margin="0,0,0,6" />
                                    <RadioButton Style="{StaticResource ModernRadioButton}" Content="Theo cửa sổ (Follow Window)"
                                                 IsChecked="{Binding IsFollowWindowMode, Mode=TwoWay}" />
                                </StackPanel>

                                <!-- Button: Chọn vùng nhận diện (Ctrl + Shift + S) -->
                                <Border Background="#251F48" BorderBrush="#7C3AED" BorderThickness="1.5" CornerRadius="8" Margin="0,0,0,8">
                                    <Button Command="{Binding SelectRegionCommand}"
                                            Background="Transparent" BorderThickness="0" Height="40" Cursor="Hand">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⛶ " Foreground="#C4B5FD" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="Chọn vùng nhận diện (Ctrl + Shift + S)" Foreground="#DDD6FE" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Border>

                                <!-- Button: Xóa vùng đã chọn -->
                                <Button Command="{Binding ClearRegionCommand}"
                                        Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextMuted}"
                                        Height="26" Cursor="Hand" Margin="0,0,0,12">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="↺ " FontSize="12" VerticalAlignment="Center" />
                                        <TextBlock Text="Xóa vùng đã chọn" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Separator Background="{StaticResource BorderBrushDark}" Margin="0,0,0,12" />

                                <!-- Ngôn ngữ gốc -->
                                <TextBlock Text="Ngôn ngữ gốc" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="0" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Aa  Tự động nhận diện" />
                                    <ComboBoxItem Content="🇨🇳  Tiếng Trung (中文)" />
                                    <ComboBoxItem Content="🇬🇧  Tiếng Anh (English)" />
                                    <ComboBoxItem Content="🇻🇳  Tiếng Việt" />
                                </ComboBox>

                                <!-- Dịch sang (Checkboxes) -->
                                <TextBlock Text="Dịch sang" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" />
                                <StackPanel Margin="0,0,0,12">
                                    <CheckBox Style="{StaticResource ModernDarkCheckBox}" Content="Tiếng Anh (English)"
                                              IsChecked="{Binding TargetEnglish}" Margin="0,0,0,6" />
                                    <CheckBox Style="{StaticResource ModernDarkCheckBox}" Content="Tiếng Trung (中文)"
                                              IsChecked="{Binding TargetChinese}" Margin="0,0,0,6" />
                                    <CheckBox Style="{StaticResource ModernDarkCheckBox}" Content="Tiếng Việt"
                                              IsChecked="{Binding TargetVietnamese}" />
                                </StackPanel>

                                <!-- Chế độ hiển thị -->
                                <TextBlock Text="Chế độ hiển thị" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="2">
                                    <ComboBoxItem Content="Một ngôn ngữ (1 dòng)" />
                                    <ComboBoxItem Content="Song ngữ (2 dòng)" />
                                    <ComboBoxItem Content="Tam ngữ (3 dòng)" />
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ================= CENTER PANEL: LIVE PREVIEW & RESULTS ================= -->
                    <Grid Grid.Column="1" Margin="0,0,14,0">
                        <Grid.RowDefinitions>
                            <!-- Live Preview Card (Height ~ 380) -->
                            <RowDefinition Height="1.4*" />
                            <!-- Realtime Results Card -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Card 1: Live Preview -->
                        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="16" Margin="0,0,0,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🖥 Xem trước vùng dịch (Live Preview)" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                    </StackPanel>

                                    <!-- Vùng đã chọn badge -->
                                    <Border HorizontalAlignment="Right" Background="#22283E" CornerRadius="6" Padding="8,4">
                                        <TextBlock Text="{Binding FormattedRegionSize, StringFormat='Vùng đã chọn: {0}'}"
                                                   Foreground="#94A3B8" FontSize="12" />
                                    </Border>
                                </Grid>

                                <!-- Preview Frame Viewport -->
                                <Border Grid.Row="1" Background="#0A0C13" CornerRadius="10" ClipToBounds="True">
                                    <Grid>
                                        <!-- Captured Image -->
                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" />

                                        <!-- Subtitle detection dashed box indicator -->
                                        <Border BorderBrush="#06B6D4" BorderThickness="1.5" CornerRadius="4"
                                                HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                Margin="0,0,0,40" Padding="14,6" Background="#2006B6D4">
                                            <TextBlock Text="{Binding OriginalText}"
                                                       Foreground="#FFFFFF" FontSize="20" FontWeight="SemiBold"
                                                       FontFamily="Microsoft YaHei, Segoe UI" TextAlignment="Center" />
                                        </Border>

                                        <!-- Media Control Bar Mock -->
                                        <Border VerticalAlignment="Bottom" Background="#800D111A" Height="32" Padding="12,0">
                                            <Grid VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="▶  ⏸  🔊" Foreground="#94A3B8" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center" />
                                                    <TextBlock Text="12:34 / 45:20" Foreground="#64748B" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>

                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <TextBlock Text="💬  ⚙  ⛶" Foreground="#94A3B8" FontSize="11" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Card 2: Realtime Results -->
                        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="💬 Kết quả realtime" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LastUpdatedText, StringFormat='Cập nhật: {0}'}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Results Rows -->
                                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                                    <!-- Row 1: Gốc (Trung) -->
                                    <Border Background="#1A1F33" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#292F4D" CornerRadius="5" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Gốc (Trung)" Foreground="#A5B4FC" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding OriginalText}"
                                                       Foreground="#FFFFFF" FontSize="16" FontWeight="Medium"
                                                       FontFamily="Microsoft YaHei, Segoe UI" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Row 2: Dịch (Anh) -->
                                    <Border Background="#1A1F33" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#292F4D" CornerRadius="5" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Dịch (Anh)" Foreground="#A5B4FC" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding EnglishText}"
                                                       Foreground="#FBBF24" FontSize="16" FontWeight="SemiBold"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>

                                    <!-- Row 3: Dịch (Việt) -->
                                    <Border Background="#1A1F33" CornerRadius="8" Padding="12,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.Column="0" Background="#292F4D" CornerRadius="5" Padding="6,2" Margin="0,0,12,0" VerticalAlignment="Center">
                                                <TextBlock Text="Dịch (Việt)" Foreground="#A5B4FC" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                            <TextBlock Grid.Column="1" Text="{Binding VietnameseText}"
                                                       Foreground="#F1F5F9" FontSize="16" FontWeight="Normal"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= RIGHT PANEL: OVERLAY SETTINGS ================= -->
                    <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="16">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="🗂 Cài đặt Overlay (Phụ đề nổi)" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,12" />

                                <!-- Hiển thị Overlay Toggle -->
                                <CheckBox Style="{StaticResource ModernToggleSwitch}" Content="Hiển thị Overlay"
                                          IsChecked="{Binding OverlayVisible}" Margin="0,0,0,12" />

                                <!-- Kiểu hiển thị -->
                                <TextBlock Text="Kiểu hiển thị" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="2" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Một ngôn ngữ (1 dòng)" />
                                    <ComboBoxItem Content="Song ngữ (2 dòng)" />
                                    <ComboBoxItem Content="Tam ngữ (3 dòng)" />
                                </ComboBox>

                                <!-- Cỡ chữ -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Cỡ chữ" Foreground="{StaticResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Command="{Binding DecreaseFontSizeCommand}"
                                                Style="{StaticResource RoundedButton}"
                                                Background="#1E2438" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                                Width="28" Height="26" Foreground="#CBD5E1" Content="A-" Margin="0,0,4,0" />
                                        <Border Background="#161A2B" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="4"
                                                Width="32" Height="26" VerticalAlignment="Center" Margin="0,0,4,0">
                                            <TextBlock Text="{Binding OverlayFontSize}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Button Command="{Binding IncreaseFontSizeCommand}"
                                                Style="{StaticResource RoundedButton}"
                                                Background="#1E2438" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                                Width="28" Height="26" Foreground="#CBD5E1" Content="A+" />
                                    </StackPanel>
                                </Grid>

                                <!-- Màu chữ -->
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Màu chữ" Foreground="{StaticResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="20" Height="20" Background="#FFFFFF" CornerRadius="4" BorderBrush="#4B5578" BorderThickness="1" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBox Text="{Binding OverlayTextColor}" Width="75" Height="26" Background="#1D2238" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}" Padding="4,2" VerticalContentAlignment="Center" FontSize="12" />
                                    </StackPanel>
                                </Grid>

                                <!-- Nền phụ đề (Độ đậm slider) -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Nền phụ đề" Foreground="{StaticResource TextSecondary}" FontSize="12.5" />
                                    <TextBlock Text="{Binding OverlayBackgroundOpacity, StringFormat='Độ đậm: {0:P0}'}" Foreground="#CBD5E1" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Style="{StaticResource ModernSlider}" Minimum="0.1" Maximum="1.0" Value="{Binding OverlayBackgroundOpacity}" Margin="0,0,0,14" />

                                <!-- Vị trí mặc định -->
                                <TextBlock Text="Vị trí mặc định" Foreground="{StaticResource TextSecondary}" FontSize="12.5" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="0" Margin="0,0,0,14">
                                    <ComboBoxItem Content="Dưới cùng (giữa)" />
                                    <ComboBoxItem Content="Trên cùng (giữa)" />
                                    <ComboBoxItem Content="Tùy chỉnh tự do" />
                                </ComboBox>

                                <Separator Background="{StaticResource BorderBrushDark}" Margin="0,0,0,12" />

                                <!-- Toggle Switches -->
                                <CheckBox Style="{StaticResource ModernToggleSwitch}" Content="Khóa vị trí Overlay"
                                          IsChecked="{Binding OverlayLocked}" Margin="0,0,0,10" />

                                <CheckBox Style="{StaticResource ModernToggleSwitch}" Content="Click-through (xuyên chuột)"
                                          IsChecked="{Binding OverlayClickThrough}" Margin="0,0,0,10" />

                                <CheckBox Style="{StaticResource ModernToggleSwitch}" Content="Luôn hiển thị trên cùng"
                                          IsChecked="{Binding OverlayAlwaysOnTop}" Margin="0,0,0,16" />

                                <!-- Button: Chỉnh sửa vị trí Overlay -->
                                <Button Command="{Binding ToggleOverlayEditModeCommand}"
                                        Style="{StaticResource RoundedButton}"
                                        Background="#1E2438" BorderBrush="{StaticResource AccentPurple}" BorderThickness="1.5"
                                        Height="38">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✏ " Foreground="#C4B5FD" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Chỉnh sửa vị trí Overlay" Foreground="#E0E7FF" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>

                <!-- ================= SETTINGS VIEW ================= -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="28">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="800" HorizontalAlignment="Left">
                                <TextBlock Text="⚙ Cài đặt hệ thống (ScreenSub AI Settings)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                <TextBlock Text="Cấu hình tài khoản Azure Translator, mã hóa bảo mật DPAPI và thông số OCR cục bộ." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,20" />

                                <!-- Section 1: Azure AI Translator -->
                                <Border Background="#1A1F33" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="🌐 Dịch thuật AI (Azure Translator)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="Thông tin API Key được mã hóa an toàn trên Windows bằng DPAPI (ProtectedData), không lưu dưới dạng văn bản thuần." Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,14" />

                                        <!-- Azure API Key -->
                                        <TextBlock Text="Azure Translator API Key" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding AzureApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#121522" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}"
                                                 Padding="10,8" FontSize="13" Margin="0,0,0,14" />

                                        <!-- Azure Region -->
                                        <TextBlock Text="Azure Region (Vùng dịch vụ)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="#121522" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}"
                                                 Padding="10,8" FontSize="13" Margin="0,0,0,14" />

                                        <!-- Use Mock Translation Checkbox -->
                                        <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                                  Content="Sử dụng Mock Translation (Chế độ Thử nghiệm offline không cần API Key)"
                                                  IsChecked="{Binding UseMockTranslation}" Margin="0,4,0,4" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: PaddleOCR Settings -->
                                <Border Background="#1A1F33" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                    <StackPanel>
                                        <TextBlock Text="🖥 Nhận diện chữ (PaddleOCR Worker)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="PaddleOCR hoạt động độc lập qua tiến trình worker nền, hỗ trợ chữ Tiếng Anh, Tiếng Trung và Tiếng Việt." Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,14" />

                                        <TextBlock Text="Tiến trình Python: python (Python 3.10+ x64)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBlock Text="Script Worker: workers/paddle-ocr/ocr_worker.py" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10" />
                                    </StackPanel>
                                </Border>

                                <!-- Save Buttons Row -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SaveSettingsCommand}"
                                            Style="{StaticResource RoundedButton}"
                                            Background="{StaticResource AccentPurple}" BorderThickness="0"
                                            Padding="20,10" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾 " Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="Lưu cài đặt" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                            Style="{StaticResource RoundedButton}"
                                            Background="#1E2438" BorderBrush="{StaticResource BorderBrushDark}"
                                            Padding="18,10" Margin="0,0,14,0">
                                        <TextBlock Text="Quay lại Dashboard" Foreground="{StaticResource TextSecondary}" FontSize="13" />
                                    </Button>

                                    <TextBlock Text="{Binding SettingsSaveMessage}" Foreground="{StaticResource AccentGreen}"
                                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
