<Window x:Class="ScreenSub.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:ScreenSub.Desktop.ViewModels"
        xmlns:enums="clr-namespace:ScreenSub.Core.Enums;assembly=ScreenSub.Core"
        mc:Ignorable="d"
        Title="ScreenSub AI — Realtime Subtitle Translator"
        Height="800" Width="1340"
        MinHeight="600" MinWidth="1024"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}"
        Foreground="{StaticResource TextPrimary}"
        FontFamily="{StaticResource AppFontFamily}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled"
        WindowStyle="None"
        AllowsTransparency="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Titlebar Control Button Style -->
        <Style x:Key="TitleBarButton" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#253248" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#1E293B" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Titlebar Close Button Style -->
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="btnBorder" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#E11D48" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="btnBorder" Property="Background" Value="#BE123C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top Status Card Style with Hover Highlight -->
        <Style x:Key="StatusCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource BgCard}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="12,8" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#1E293B" />
                    <Setter Property="BorderBrush" Value="#475569" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootLayoutGrid" Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <!-- Custom Title Bar -->
            <RowDefinition Height="44" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= TITLE BAR ================= -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,0,1">
            <Grid Margin="16,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Logo & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Violet Play Logo Icon -->
                    <Border Width="28" Height="28" CornerRadius="8" Margin="0,0,10,0">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#8B5CF6" Offset="0" />
                                <GradientStop Color="#6366F1" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <TextBlock Text="▶" Foreground="#FFFFFF" FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="2,0,0,0" />
                    </Border>

                    <TextBlock Text="ScreenSub AI" FontWeight="Bold" FontSize="15" Foreground="#FFFFFF" VerticalAlignment="Center" />

                    <!-- MVP Badge -->
                    <Border Background="#252445" BorderBrush="#7C3AED" BorderThickness="1" CornerRadius="4" Padding="6,2" Margin="8,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="MVP" FontSize="10.5" FontWeight="Bold" Foreground="#C4B5FD" />
                    </Border>

                    <TextBlock Text="Dịch phụ đề màn hình realtime · Anh – Trung – Việt" Foreground="{StaticResource TextMuted}" FontSize="12.5" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Window Control Buttons (Min, Max, Close) -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMinimizeClick" ToolTip="Thu nhỏ">
                        <TextBlock Text="—" FontSize="11" />
                    </Button>
                    <Button Style="{StaticResource TitleBarButton}" Click="OnMaximizeClick" ToolTip="Phóng to / Khôi phục">
                        <TextBlock x:Name="MaximizeButtonGlyph" Text="▢" FontSize="13" />
                    </Button>
                    <Button Style="{StaticResource TitleBarCloseButton}" Click="OnCloseClick" ToolTip="Đóng">
                        <TextBlock Text="✕" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= MAIN BODY ================= -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="206" />
                <!-- Content View -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ================= SIDEBAR ================= -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="0,0,1,0">
                <Grid Margin="10,14,10,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Nav Buttons -->
                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                        <!-- Dashboard Button -->
                        <Border CornerRadius="10" Margin="0,0,0,6">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="Dashboard">
                                            <Setter Property="Background" Value="{StaticResource AccentPurple}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                    Foreground="#FFFFFF">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏠" FontSize="15" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Dashboard" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>

                        <!-- Screen Capture Nav -->
                        <Button Style="{StaticResource SidebarNavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🖥" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Chụp màn hình" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Translation Nav -->
                        <Button Style="{StaticResource SidebarNavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🌐" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Dịch thuật" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Overlay Settings Nav -->
                        <Button Style="{StaticResource SidebarNavButton}"
                                Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                Margin="0,0,0,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗂" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                <TextBlock Text="Cài đặt Overlay" FontSize="13.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Settings Nav -->
                        <Border CornerRadius="10" Margin="0,0,0,4">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                            <Setter Property="Background" Value="{StaticResource AccentPurple}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Button Style="{StaticResource SidebarNavButton}"
                                    Command="{Binding NavigateCommand}" CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cài đặt" FontSize="13.5" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Bottom Status Card in Sidebar -->
                    <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="12" Padding="14,12" ToolTip="{Binding DiagnosticsTooltipText}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding PipelineStatusText}" Foreground="{StaticResource AccentGreen}" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>

                            <Grid Margin="0,2">
                                <TextBlock Text="{Binding OcrFooterText}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding OcrFooterStatusIcon}" Foreground="{Binding OcrFooterColor}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,2">
                                <TextBlock Text="{Binding TranslationFooterText}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="{Binding TranslationFooterStatusIcon}" Foreground="{Binding TranslationFooterColor}" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" />
                            </Grid>

                            <Grid Margin="0,4,0,0">
                                <TextBlock Text="{Binding FormattedLatencyText, StringFormat='Độ trễ: {0}'}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                <TextBlock Text="📊" HorizontalAlignment="Right" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- ================= MAIN CONTENT VIEW ================= -->
            <Grid Grid.Column="1" Margin="18,12,18,14">
                <Grid.RowDefinitions>
                    <!-- Header with Title & Top Status Badges -->
                    <RowDefinition Height="Auto" />
                    <!-- Content Area -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Header Row (2-row responsive layout: zero title/KPI collision at any width or DPI) -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Dashboard" FontSize="22" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" Margin="0,0,14,0" />
                        <TextBlock Text="Theo dõi, nhận diện và dịch phụ đề màn hình đa ngôn ngữ thời gian thực."
                                   Foreground="{StaticResource TextSecondary}" FontSize="12.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <!-- Top System Status Cards (Proportional 5-column responsive bar with ellipsis & tooltip) -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="0.95*" />
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1.35*" />
                            <ColumnDefinition Width="0.80*" />
                        </Grid.ColumnDefinitions>

                        <!-- Card 0: AI Provider Badge (Phase 9) -->
                        <Border Grid.Column="0" Style="{StaticResource StatusCardBorder}" Padding="10,7" Margin="0,0,8,0" ToolTip="{Binding ActiveProviderBadgeText}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" Background="{StaticResource BgCardElevated}" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="⚡" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ĐỘNG CƠ AI" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                    <TextBlock Text="{Binding ActiveProviderBadgeText}" FontSize="11" FontWeight="Bold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#38BDF8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsTranslationHealthy}" Value="False">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmber}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 0B: Quick Translate Hotkey Badge (Phase 11) -->
                        <Border Grid.Column="1" Style="{StaticResource StatusCardBorder}" Padding="10,7" Margin="0,0,8,0" ToolTip="{Binding HotkeyDisplayText}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" Background="{StaticResource BgCardElevated}" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="🚀" Foreground="#38BDF8" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="QUICK TRANSLATE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding HotkeyDisplayText}" Foreground="#38BDF8" FontSize="11.5" FontWeight="Bold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 1: OCR Badge -->
                        <Border Grid.Column="2" Style="{StaticResource StatusCardBorder}" Padding="10,7" Margin="0,0,8,0" ToolTip="{Binding OcrStatusText}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" Background="{StaticResource BgCardElevated}" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="🖥" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="OCR ENGINE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="6" Height="6" Fill="{StaticResource AccentGreen}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding OcrStatusText}" Foreground="{StaticResource AccentGreen}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 2: Translation Badge -->
                        <Border Grid.Column="3" Style="{StaticResource StatusCardBorder}" Padding="10,7" Margin="0,0,8,0" ToolTip="{Binding TranslationStatusText}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" Background="{StaticResource BgCardElevated}" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="文" Foreground="#A5B4FC" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" FontWeight="Bold" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="DỊCH THUẬT" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                        <Border CornerRadius="3" Padding="4,1" Margin="6,0,0,0" Background="#78350F" BorderBrush="{StaticResource AccentAmber}" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsMockMode}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="DEMO" Foreground="#FDE68A" FontSize="9" FontWeight="Bold" />
                                        </Border>
                                    </StackPanel>
                                    <Grid Margin="0,1,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="6" Height="6" Margin="0,0,4,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{StaticResource AccentGreen}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTranslationHealthy}" Value="False">
                                                            <Setter Property="Fill" Value="{StaticResource AccentAmber}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Grid.Column="1" Text="{Binding TranslationStatusText}" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsTranslationHealthy}" Value="False">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentAmber}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Card 3: Latency Badge -->
                        <Border Grid.Column="4" Style="{StaticResource StatusCardBorder}" Padding="10,7" ToolTip="{Binding DiagnosticsTooltipText}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="26" Height="26" Background="{StaticResource BgCardElevated}" CornerRadius="6" Margin="0,0,8,0">
                                    <TextBlock Text="⏱" Foreground="#93C5FD" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12.5" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="ĐỘ TRỄ (TB)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding FormattedLatencyText}" Foreground="#FFFFFF" FontSize="12" FontWeight="SemiBold" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- ================= TAB 1: DASHBOARD MAIN CONTENT ================= -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Grid.RowDefinitions>
                        <!-- Row 0: First Run Experience Guidance Banner -->
                        <RowDefinition Height="Auto" />
                        <!-- Row 1: 3-Column Dashboard Content -->
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- First Run Experience Guidance Banner (Phase 11) -->
                    <Border Grid.Row="0" Background="#1E1B4B" BorderBrush="#6366F1" BorderThickness="1.5" CornerRadius="10" Padding="16,12" Margin="0,0,0,14"
                            Visibility="{Binding ShowFirstRunBanner, Converter={StaticResource BoolToVis}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="👋" FontSize="24" Margin="0,0,12,0" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Chào mừng bạn đến với ScreenSub AI — Hướng dẫn bắt đầu nhanh" Foreground="#FFFFFF" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,2" />
                                <TextBlock Text="Chỉ cần mở video trên Chrome/Edge và nhấn phím tắt Ctrl + Alt + Q để quét vùng phụ đề. Ứng dụng sẽ tự động dịch ngay trên video mà không cần mở lại Dashboard!"
                                           Foreground="#C7D2FE" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                <Button Command="{Binding NavigateCommand}" CommandParameter="Cài đặt"
                                        Style="{StaticResource SecondaryDarkButton}" Padding="12,6" Height="32" Margin="0,0,8,0">
                                    <TextBlock Text="⚙ Cài đặt mô hình" FontSize="11.5" />
                                </Button>
                                <Button Command="{Binding DismissFirstRunBannerCommand}"
                                        Style="{StaticResource PurpleActionButton}" Padding="12,6" Height="32">
                                    <TextBlock Text="✕ Đã hiểu, ẩn thông báo" FontSize="11.5" FontWeight="SemiBold" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- 3-Column Dashboard Content -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <!-- Column 0: Translation Controls -->
                            <ColumnDefinition Width="312" MinWidth="288" />
                            <!-- Column 1: Center Live Preview & Results (Flexible) -->
                            <ColumnDefinition Width="*" MinWidth="360" />
                            <!-- Column 2: Overlay Settings -->
                            <ColumnDefinition Width="292" MinWidth="268" />
                        </Grid.ColumnDefinitions>

                    <!-- ================= LEFT COLUMN: TRANSLATION CONTROLS ================= -->
                    <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,12,0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,0">
                                <!-- Card Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="⚡" Foreground="{StaticResource AccentAmber}" FontSize="15" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Điều khiển nhanh" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Action Buttons: Start, Pause, Stop with distinct hover feedback -->
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.42*" />
                                        <ColumnDefinition Width="1.15*" />
                                        <ColumnDefinition Width="0.88*" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Start Button -->
                                    <Button Grid.Column="0" Command="{Binding StartTranslationCommand}"
                                            Style="{StaticResource GreenActionButton}"
                                            Padding="6,0" Margin="0,0,5,0" ToolTip="Bắt đầu nhận diện và dịch">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="▶ " Foreground="#FFFFFF" FontSize="11.5" VerticalAlignment="Center" />
                                            <TextBlock Text="Bắt đầu dịch" Foreground="#FFFFFF" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Pause Button -->
                                    <Button Grid.Column="1" Command="{Binding PauseTranslationCommand}"
                                            Style="{StaticResource SecondaryDarkButton}"
                                            Height="40" Padding="4,0" Margin="0,0,5,0" ToolTip="Tạm dừng nhận diện">
                                        <TextBlock Text="⏸ Tạm dừng" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>

                                    <!-- Stop Button -->
                                    <Button Grid.Column="2" Command="{Binding StopTranslationCommand}"
                                            Style="{StaticResource StopDangerButton}"
                                            Height="40" Padding="4,0" ToolTip="Dừng và xóa phụ đề">
                                        <TextBlock Text="⏹ Dừng" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </Grid>

                                <!-- Chế độ dịch thuật (Mode Switcher - Phase 8) -->
                                <TextBlock Text="Chế độ dịch thuật" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- Màn hình (OCR) -->
                                        <RadioButton Grid.Column="0" Content="🖥 OCR"
                                                     IsChecked="{Binding IsScreenOcrMode, Mode=OneWay}"
                                                     Command="{Binding SelectTranslationModeCommand}"
                                                     CommandParameter="{x:Static enums:TranslationMode.ScreenOcr}"
                                                     Style="{StaticResource ModeTabRadioButton}"
                                                     ToolTip="Chế độ dịch phụ đề từ màn hình qua OCR (Mặc định)" />
                                        <!-- Âm thanh (Audio) -->
                                        <RadioButton Grid.Column="1" Content="🎙 Audio"
                                                     IsChecked="{Binding IsAudioRealtimeMode, Mode=OneWay}"
                                                     Command="{Binding SelectTranslationModeCommand}"
                                                     CommandParameter="{x:Static enums:TranslationMode.AudioRealtime}"
                                                     Style="{StaticResource ModeTabRadioButton}"
                                                     ToolTip="Chế độ dịch giọng nói trực tiếp từ âm thanh Windows (Whisper ASR)" />
                                        <!-- Kết hợp (Hybrid) -->
                                        <RadioButton Grid.Column="2" Content="⚡ Hybrid"
                                                     IsChecked="{Binding IsHybridMode, Mode=OneWay}"
                                                     Command="{Binding SelectTranslationModeCommand}"
                                                     CommandParameter="{x:Static enums:TranslationMode.Hybrid}"
                                                     Style="{StaticResource ModeTabRadioButton}"
                                                     ToolTip="Chế độ kết hợp nhận diện màn hình và âm thanh song song" />
                                    </Grid>
                                </Border>

                                <!-- Chế độ Động cơ AI (Phase 9) -->
                                <TextBlock Text="Động cơ AI dịch thuật" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Border Background="#0F172A" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="3" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button Grid.Column="0" Command="{Binding SetEngineModeCommand}"
                                                CommandParameter="{x:Static enums:TranslationEngineMode.Offline}"
                                                Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                                                    <TextBlock Text="🔒 Cục bộ" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding TranslationEngineMode}" Value="{x:Static enums:TranslationEngineMode.Offline}">
                                                                        <Setter TargetName="b" Property="Background" Value="#1E293B" />
                                                                        <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource AccentGreen}" />
                                                                        <Setter TargetName="b" Property="BorderThickness" Value="1" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="1" Command="{Binding SetEngineModeCommand}"
                                                CommandParameter="{x:Static enums:TranslationEngineMode.Online}"
                                                Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                                                    <TextBlock Text="🌐 Azure" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding TranslationEngineMode}" Value="{x:Static enums:TranslationEngineMode.Online}">
                                                                        <Setter TargetName="b" Property="Background" Value="#1E293B" />
                                                                        <Setter TargetName="b" Property="BorderBrush" Value="#38BDF8" />
                                                                        <Setter TargetName="b" Property="BorderThickness" Value="1" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <Button Grid.Column="2" Command="{Binding SetEngineModeCommand}"
                                                CommandParameter="{x:Static enums:TranslationEngineMode.Auto}"
                                                Height="30" Background="Transparent" BorderThickness="0" Cursor="Hand">
                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Template">
                                                        <Setter.Value>
                                                            <ControlTemplate TargetType="Button">
                                                                <Border x:Name="b" Background="Transparent" CornerRadius="6">
                                                                    <TextBlock Text="🔄 Tự động" Foreground="{StaticResource TextSecondary}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                                </Border>
                                                                <ControlTemplate.Triggers>
                                                                    <DataTrigger Binding="{Binding TranslationEngineMode}" Value="{x:Static enums:TranslationEngineMode.Auto}">
                                                                        <Setter TargetName="b" Property="Background" Value="#1E293B" />
                                                                        <Setter TargetName="b" Property="BorderBrush" Value="#F59E0B" />
                                                                        <Setter TargetName="b" Property="BorderThickness" Value="1" />
                                                                    </DataTrigger>
                                                                </ControlTemplate.Triggers>
                                                            </ControlTemplate>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </Grid>
                                </Border>

                                <!-- ================= SCREEN OCR CONTROLS (PHASE 1-7) ================= -->
                                <StackPanel Visibility="{Binding ShowScreenCaptureControls, Converter={StaticResource BoolToVis}}">
                                    <!-- Nguồn Chụp -->
                                    <TextBlock Text="Nguồn chụp" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="{Binding CaptureSourceIndex, Mode=TwoWay}" Margin="0,0,0,8">
                                        <ComboBoxItem Content="🖥 Cửa sổ ứng dụng" />
                                        <ComboBoxItem Content="🌐 Toàn màn hình" />
                                    </ComboBox>

                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding OpenWindows}"
                                                  SelectedItem="{Binding SelectedWindow}"
                                                  DisplayMemberPath="DisplayText"
                                                  ToolTip="Chọn cửa sổ đích để nhận diện phụ đề" />
                                        <Button Grid.Column="1" Command="{Binding RefreshWindowsCommand}"
                                                Style="{StaticResource SecondaryDarkButton}"
                                                Width="36" Height="38" Margin="6,0,0,0" ToolTip="Làm mới danh sách cửa sổ">
                                            <TextBlock Text="🔄" FontSize="12" />
                                        </Button>
                                    </Grid>

                                    <!-- Chế độ vùng dịch (Radio Buttons) -->
                                    <TextBlock Text="Chế độ vùng dịch ⓘ" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <StackPanel Margin="0,0,0,14">
                                        <RadioButton Style="{StaticResource ModernRadioButton}" Content="Vùng cố định (Fixed Region)"
                                                     IsChecked="{Binding IsFixedRegionMode, Mode=TwoWay}" Margin="0,0,0,6" />
                                        <RadioButton Style="{StaticResource ModernRadioButton}" Content="Theo cửa sổ (Follow Window)"
                                                     IsChecked="{Binding IsFollowWindowMode, Mode=TwoWay}" />
                                    </StackPanel>

                                    <!-- Button: Chọn vùng nhận diện (Ctrl + Alt + Q) -->
                                    <Button Command="{Binding SelectRegionCommand}"
                                            Style="{StaticResource PurpleActionButton}"
                                            Height="42" Margin="0,0,0,6" ToolTip="Kích hoạt công cụ chọn vùng màn hình">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="⛶ " Foreground="#FFFFFF" FontSize="14" FontWeight="Bold" Margin="0,0,6,0" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding HotkeyDisplayText, StringFormat='Chọn vùng nhận diện ({0})'}" Foreground="#FFFFFF" FontWeight="Bold" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <!-- Quick Translate Mode Quick Toggle -->
                                    <CheckBox IsChecked="{Binding QuickTranslateMode}"
                                              Foreground="{StaticResource TextSecondary}"
                                              FontSize="11.5" Margin="2,2,0,6"
                                              VerticalContentAlignment="Top"
                                              ToolTip="Khi bật, sau khi thả chuột chọn vùng phụ đề, ứng dụng tự động dịch ngay lập tức mà không cần nhấn Bắt đầu dịch.">
                                        <TextBlock Text="Tự động dịch ngay sau khi chọn (Quick Translate)"
                                                   TextWrapping="Wrap" />
                                    </CheckBox>

                                    <!-- Button: Xóa vùng đã chọn -->
                                    <Button Command="{Binding ClearRegionCommand}"
                                            Style="{StaticResource GhostTextButton}"
                                            Margin="0,0,0,12" ToolTip="Xóa vùng đã chọn và reset trạng thái">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <TextBlock Text="↺ " FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="Xóa vùng đã chọn" FontSize="12" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>

                                <!-- ================= AUDIO TRANSLATION CONTROLS (PHASE 8) ================= -->
                                <StackPanel Visibility="{Binding ShowAudioControls, Converter={StaticResource BoolToVis}}" Margin="0,0,0,10">
                                    <!-- Thiết bị âm thanh -->
                                    <TextBlock Text="Thiết bị âm thanh (Loopback)" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Grid.Column="0" Style="{StaticResource ModernComboBox}"
                                                  ItemsSource="{Binding AudioDevices}"
                                                  SelectedItem="{Binding SelectedAudioDevice}"
                                                  DisplayMemberPath="Name"
                                                  ToolTip="Chọn thiết bị âm thanh để thu và dịch lời thoại" />
                                        <Button Grid.Column="1" Command="{Binding RefreshAudioDevicesCommand}"
                                                Style="{StaticResource SecondaryDarkButton}"
                                                Width="36" Height="38" Margin="6,0,0,0" ToolTip="Làm mới danh sách thiết bị âm thanh">
                                            <TextBlock Text="🔄" FontSize="12" />
                                        </Button>
                                    </Grid>

                                    <!-- Realtime Audio VU Meter -->
                                    <Grid Margin="0,0,0,4">
                                        <TextBlock Text="Tín hiệu âm thanh" Foreground="{StaticResource TextSecondary}" FontSize="11.5" />
                                        <TextBlock Text="{Binding FormattedAudioLevel}" Foreground="{StaticResource AccentGreen}" FontSize="11.5" FontWeight="Bold" HorizontalAlignment="Right" />
                                    </Grid>
                                    <ProgressBar Style="{StaticResource AudioMeterProgressBar}"
                                                 Value="{Binding AudioPeakLevel}" Minimum="0" Maximum="1"
                                                 Margin="0,0,0,12" ToolTip="Cường độ âm thanh thu được từ hệ thống Windows (Peak Meter)" />

                                    <!-- Ngôn ngữ giọng nói (Whisper ASR) -->
                                    <TextBlock Text="Ngôn ngữ giọng nói (Whisper)" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                    <ComboBox Style="{StaticResource ModernComboBox}" SelectedValue="{Binding SpeechLanguage, Mode=TwoWay}" SelectedValuePath="Tag" Margin="0,0,0,6">
                                        <ComboBoxItem Content="🌐  Tự động nhận diện (Auto)" Tag="auto" />
                                        <ComboBoxItem Content="🇬🇧  Tiếng Anh (English)" Tag="en" />
                                        <ComboBoxItem Content="🇨🇳  Tiếng Trung (中文)" Tag="zh" />
                                        <ComboBoxItem Content="🇻🇳  Tiếng Việt (Vietnamese)" Tag="vi" />
                                    </ComboBox>
                                </StackPanel>

                                <Separator Background="{StaticResource BorderBrushDark}" Margin="0,0,0,12" />

                                <!-- Ngôn ngữ gốc -->
                                <TextBlock Text="Ngôn ngữ gốc" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="{Binding SourceLanguageIndex, Mode=TwoWay}" Margin="0,0,0,12">
                                    <ComboBoxItem Content="Aa  Tự động nhận diện" />
                                    <ComboBoxItem Content="🇨🇳  Tiếng Trung (中文)" />
                                    <ComboBoxItem Content="🇬🇧  Tiếng Anh (English)" />
                                    <ComboBoxItem Content="🇻🇳  Tiếng Việt" />
                                </ComboBox>

                                <!-- Dịch sang (Checkboxes) -->
                                <TextBlock Text="Dịch sang" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <StackPanel Margin="0,0,0,12">
                                    <CheckBox Style="{StaticResource ModernDarkCheckBox}" Content="Tiếng Anh (English)"
                                              IsChecked="{Binding TargetEnglish}" Margin="0,0,0,6" />
                                    <CheckBox Style="{StaticResource ModernDarkCheckBox}" Content="Tiếng Trung (中文)"
                                              IsChecked="{Binding TargetChinese}" Margin="0,0,0,6" />
                                    <CheckBox Style="{StaticResource ModernDarkCheckBox}" Content="Tiếng Việt"
                                              IsChecked="{Binding TargetVietnamese}" />
                                </StackPanel>

                                <!-- Chế độ hiển thị -->
                                <TextBlock Text="Chế độ hiển thị" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="{Binding DisplayModeIndex, Mode=TwoWay}">
                                    <ComboBoxItem Content="Một ngôn ngữ (1 dòng)" />
                                    <ComboBoxItem Content="Song ngữ (2 dòng)" />
                                    <ComboBoxItem Content="Tam ngữ (3 dòng)" />
                                </ComboBox>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- ================= CENTER PANEL: LIVE PREVIEW & RESULTS ================= -->
                    <Grid Grid.Column="1" Margin="0,0,12,0">
                        <Grid.RowDefinitions>
                            <!-- Live Preview Card (Flexible 1.25*) -->
                            <RowDefinition Height="1.25*" />
                            <!-- Realtime Results Card (1.0*) -->
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Card 1: Live Preview (Video Monitoring Panel) -->
                        <Border Grid.Row="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="14" Margin="0,0,0,12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Card Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="🖥 Xem trước vùng dịch (Live Preview)" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAudioRealtimeMode}" Value="True">
                                                            <Setter Property="Text" Value="🎙 Nhận diện âm thanh realtime (Audio Monitor)" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <!-- Vùng đã chọn badge -->
                                    <Border HorizontalAlignment="Right" Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="6" Padding="8,4">
                                        <TextBlock Foreground="{StaticResource TextSecondary}" FontSize="11.5" FontWeight="Medium">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Text" Value="{Binding FormattedRegionSize, StringFormat='Vùng đã chọn: {0}'}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAudioRealtimeMode}" Value="True">
                                                            <Setter Property="Text" Value="Chế độ: Thu âm thanh Windows" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </Grid>

                                <!-- Preview Frame Viewport Content -->
                                <Grid Grid.Row="1">
                                    <!-- ================= AUDIO REALTIME MONITOR VIEWPORT (AUDIO MODE) ================= -->
                                    <Border Background="#090D1A" CornerRadius="10" Padding="20">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioRealtimeMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <!-- Microphone / Waveform Badge -->
                                            <Border Width="64" Height="64" CornerRadius="32" Background="#131B2E" BorderBrush="{StaticResource AccentPurple}" BorderThickness="1.5" Margin="0,0,0,14">
                                                <TextBlock Text="🎙" FontSize="28" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="Đang lắng nghe âm thanh hệ thống (WASAPI Loopback)" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                            <TextBlock Text="Tự động nhận diện giọng nói từ video, phim, livestream bằng Whisper AI"
                                                       FontSize="12.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,14" />

                                            <!-- Live Audio Level Meter in Center -->
                                            <Border Background="#101827" BorderBrush="#1F2937" BorderThickness="1" CornerRadius="8" Padding="14,10" MinWidth="340" Margin="0,0,0,10">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,6">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                            <TextBlock Text="{Binding SelectedAudioDevice.Name, TargetNullValue='Thiết bị âm thanh mặc định'}" Foreground="{StaticResource TextSecondary}" FontSize="12" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding FormattedAudioLevel}" Foreground="{StaticResource AccentGreen}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" />
                                                    </Grid>
                                                    <ProgressBar Style="{StaticResource AudioMeterProgressBar}" Height="10"
                                                                 Value="{Binding AudioPeakLevel}" Minimum="0" Maximum="1" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Live Recognized Speech Prompt Bubble -->
                                            <Border Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="8" Padding="14,8"
                                                    MaxWidth="520" Margin="0,6,0,0">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDetectedText}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <TextBlock Text="🗣 " FontSize="14" Foreground="#A5B4FC" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding OriginalText}" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF"
                                                               FontFamily="{StaticResource AppFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- ================= SCREEN CAPTURE VIEWPORT (OCR & HYBRID MODES) ================= -->
                                    <Border Background="#090D1A" CornerRadius="10" ClipToBounds="True">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAudioRealtimeMode}" Value="True">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <!-- Placeholder Empty State when no image -->
                                            <Border>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPreviewImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <!-- Radar / Target Icon -->
                                                    <Border Width="64" Height="64" CornerRadius="32" Background="#131B2E" BorderBrush="#25334D" BorderThickness="1.5" Margin="0,0,0,14">
                                                        <TextBlock Text="⛶" FontSize="26" Foreground="{StaticResource AccentPurple}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="Chưa có hình ảnh capture" FontSize="15" FontWeight="SemiBold" Foreground="#F8FAFC" HorizontalAlignment="Center" />
                                                    <TextBlock Text="{Binding HotkeyDisplayText, StringFormat='Nhấn chọn vùng ({0}) rồi nhấn \'Bắt đầu dịch\''}"
                                                               FontSize="12.5" Foreground="{StaticResource TextMuted}" HorizontalAlignment="Center" Margin="0,4,0,14" />
                                                    <Button Command="{Binding SelectRegionCommand}"
                                                            Style="{StaticResource SecondaryDarkButton}"
                                                            Padding="18,9" HorizontalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="⛶ " Foreground="{StaticResource AccentPurple}" FontSize="13" VerticalAlignment="Center" />
                                                            <TextBlock Text="Chọn vùng ngay" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Border>

                                            <!-- Real Captured Screen Image -->
                                            <Image Source="{Binding PreviewImage}" Stretch="Uniform">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Setter Property="Visibility" Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPreviewImage}" Value="False">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>

                                            <!-- Subtitle detection dashed box indicator (only visible when text actually detected!) -->
                                            <Border BorderBrush="#06B6D4" BorderThickness="1.5" CornerRadius="4"
                                                    HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                    Margin="0,0,0,24" Padding="14,6" Background="#3306B6D4">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasDetectedText}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding OriginalText}"
                                                           Foreground="#FFFFFF" FontSize="18" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource AppFontFamily}" TextAlignment="Center" />
                                            </Border>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Card 2: Realtime Results -->
                        <Border Grid.Row="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!-- Header -->
                                <Grid Grid.Row="0" Margin="0,0,0,10">
                                    <TextBlock Text="💬 Kết quả realtime" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Fill="{StaticResource AccentGreen}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding LastUpdatedText, StringFormat='Cập nhật: {0}'}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Grid>

                                <!-- Results Rows -->
                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel VerticalAlignment="Top" Margin="0,0,4,0">
                                        <!-- Row 1: Original Text -->
                                        <Border Background="{StaticResource BgCardElevated}" BorderBrush="#27354F" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#1E1B4B" BorderBrush="#4338CA" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding OriginalLanguageBadge}" Foreground="#A5B4FC" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding OriginalText}"
                                                           Foreground="#FFFFFF" FontSize="16" FontWeight="SemiBold"
                                                           FontFamily="{StaticResource AppFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Row 2: English Translation (Shown when needed and not redundant) -->
                                        <Border Background="{StaticResource BgCardElevated}" BorderBrush="#27354F" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                                                Visibility="{Binding ShowEnglishTranslationRow, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#1E293B" BorderBrush="{StaticResource AccentBlue}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Dịch (Anh)" Foreground="#93C5FD" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding EnglishText}"
                                                           Foreground="#F8FAFC" FontSize="15" FontWeight="Medium"
                                                           FontFamily="{StaticResource AppFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Row 3: Chinese Translation (Shown when needed and not redundant) -->
                                        <Border Background="{StaticResource BgCardElevated}" BorderBrush="#27354F" BorderThickness="1" CornerRadius="10" Padding="12,8" Margin="0,0,0,8"
                                                Visibility="{Binding ShowChineseTranslationRow, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#2E1065" BorderBrush="{StaticResource AccentPurple}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Dịch (Trung)" Foreground="#C4B5FD" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding ChineseText}"
                                                           Foreground="#F8FAFC" FontSize="15" FontWeight="Medium"
                                                           FontFamily="{StaticResource AppFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>

                                        <!-- Row 4: Vietnamese Translation (Shown when needed and not redundant) -->
                                        <Border Background="{StaticResource BgCardElevated}" BorderBrush="#27354F" BorderThickness="1" CornerRadius="10" Padding="12,8"
                                                Visibility="{Binding ShowVietnameseTranslationRow, Converter={StaticResource BoolToVis}}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border Grid.Column="0" Background="#064E3B" BorderBrush="{StaticResource AccentGreen}" BorderThickness="1" CornerRadius="6" Padding="10,4" Margin="0,0,14,0" VerticalAlignment="Center">
                                                    <TextBlock Text="Dịch (Việt)" Foreground="#6EE7B7" FontSize="12" FontWeight="SemiBold" FontFamily="{StaticResource AppFontFamily}" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding VietnameseText}"
                                                           Foreground="#F8FAFC" FontSize="15" FontWeight="Medium"
                                                           FontFamily="{StaticResource AppFontFamily}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ================= RIGHT COLUMN: OVERLAY SETTINGS ================= -->
                    <Border Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel Margin="0,0,4,4">
                                <!-- Card Header -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                    <TextBlock Text="🗂" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Cài đặt Overlay (Phụ đề nổi)" FontSize="14.5" FontWeight="Bold" Foreground="#FFFFFF" VerticalAlignment="Center" />
                                </StackPanel>

                                <!-- Toggle: Hiển thị Overlay -->
                                <Grid Margin="0,0,0,14">
                                    <TextBlock Text="Hiển thị Overlay" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox HorizontalAlignment="Right" Style="{StaticResource ModernToggleSwitch}"
                                              IsChecked="{Binding OverlayVisible}" />
                                </Grid>

                                <!-- Kiểu hiển thị -->
                                <TextBlock Text="Kiểu hiển thị" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="{Binding DisplayModeIndex, Mode=TwoWay}" Margin="0,0,0,14">
                                    <ComboBoxItem Content="Một ngôn ngữ (1 dòng)" />
                                    <ComboBoxItem Content="Song ngữ (2 dòng)" />
                                    <ComboBoxItem Content="Tam ngữ (3 dòng)" />
                                </ComboBox>

                                <!-- Cỡ chữ -->
                                <TextBlock Text="Cỡ chữ" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0" Command="{Binding DecreaseFontSizeCommand}"
                                            Style="{StaticResource SecondaryDarkButton}"
                                            Width="36" Height="36" ToolTip="Giảm cỡ chữ">
                                        <TextBlock Text="A-" FontWeight="Bold" FontSize="13" />
                                    </Button>

                                    <Border Grid.Column="1" Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1"
                                            CornerRadius="8" Margin="8,0" Height="36">
                                        <TextBlock Text="{Binding OverlayFontSize, StringFormat='{}{0:0}'}"
                                                   Foreground="#FFFFFF" FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>

                                    <Button Grid.Column="2" Command="{Binding IncreaseFontSizeCommand}"
                                            Style="{StaticResource SecondaryDarkButton}"
                                            Width="36" Height="36" ToolTip="Tăng cỡ chữ">
                                        <TextBlock Text="A+" FontWeight="Bold" FontSize="13" />
                                    </Button>
                                </Grid>

                                <!-- Màu chữ -->
                                <TextBlock Text="Màu chữ" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="36" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Width="36" Height="36" Background="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="6" />
                                    <TextBox Grid.Column="1" Text="{Binding OverlayTextColor}"
                                             Background="{StaticResource BgCardElevated}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}"
                                             FontSize="13" FontWeight="SemiBold" VerticalContentAlignment="Center" Padding="10,0" Margin="8,0,0,0" Height="36" />
                                </Grid>

                                <!-- Nền phụ đề Slider -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Nền phụ đề" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OverlayBackgroundOpacity, StringFormat='Độ đậm: {0:P0}'}"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Style="{StaticResource ModernSlider}"
                                        Minimum="0" Maximum="1" Value="{Binding OverlayBackgroundOpacity}"
                                        SmallChange="0.05" LargeChange="0.1" Margin="0,4,0,14" />

                                <!-- Độ rộng khung phụ đề (Subtitle Width - Phase 11) -->
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Độ rộng khung phụ đề" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding OverlayWidth, StringFormat='{}{0:0} px'}"
                                               Foreground="{StaticResource TextSecondary}" FontSize="12" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Style="{StaticResource ModernSlider}"
                                        Minimum="500" Maximum="1600" Value="{Binding OverlayWidth}"
                                        SmallChange="20" LargeChange="50" Margin="0,4,0,14" />

                                <!-- Vị trí mặc định -->
                                <TextBlock Text="Vị trí mặc định" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6" />
                                <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="0" Margin="0,0,0,16">
                                    <ComboBoxItem Content="Dưới cùng (giữa)" />
                                    <ComboBoxItem Content="Trên cùng (giữa)" />
                                    <ComboBoxItem Content="Tùy chỉnh tự do" />
                                </ComboBox>

                                <Separator Background="{StaticResource BorderBrushDark}" Margin="0,0,0,14" />

                                <!-- Toggles Group -->
                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Khóa vị trí Overlay" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox HorizontalAlignment="Right" Style="{StaticResource ModernToggleSwitch}"
                                              IsChecked="{Binding OverlayLocked}" />
                                </Grid>

                                <Grid Margin="0,0,0,12">
                                    <TextBlock Text="Click-through (xuyên chuột)" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox HorizontalAlignment="Right" Style="{StaticResource ModernToggleSwitch}"
                                              IsChecked="{Binding OverlayClickThrough}" />
                                </Grid>

                                <Grid Margin="0,0,0,18">
                                    <TextBlock Text="Luôn hiển thị trên cùng" Foreground="{StaticResource TextPrimary}" FontSize="13" VerticalAlignment="Center" />
                                    <CheckBox HorizontalAlignment="Right" Style="{StaticResource ModernToggleSwitch}"
                                              IsChecked="{Binding OverlayAlwaysOnTop}" />
                                </Grid>

                                <!-- Button: Chỉnh sửa vị trí Overlay -->
                                <Button Command="{Binding ToggleOverlayEditModeCommand}"
                                        Style="{StaticResource EditOverlayButton}"
                                        Margin="0,0,0,8"
                                        ToolTip="Bật/Tắt chế độ kéo thả cửa sổ phụ đề">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="✏ " Foreground="{StaticResource AccentPurple}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="Chỉnh sửa vị trí Overlay" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <!-- Button: Test Overlay -->
                                <Button Command="{Binding TestOverlayCommand}"
                                        Style="{StaticResource SecondaryDarkButton}"
                                        Height="38"
                                        ToolTip="Hiển thị thử một phụ đề mẫu [TEST] trên Overlay để kiểm tra vị trí, font và DPI">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <TextBlock Text="🧪 " FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Text="Kiểm tra hiển thị Overlay" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    </Grid>
                </Grid>

                <!-- ================= TAB 2: SETTINGS CONTENT ================= -->
                <Grid Grid.Row="1">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding CurrentTab}" Value="Settings">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>

                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="14" Padding="28">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                                <TextBlock Text="⚙ Cài đặt hệ thống (ScreenSub AI Settings)" FontSize="20" FontWeight="Bold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                <TextBlock Text="Cấu hình phím tắt toàn cục, tài khoản Azure Translator và thông số nhận diện OCR cục bộ." Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,20" />

                                <!-- Section 1: Global Hotkey Configuration -->
                                <Border Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="⌨ Phím tắt toàn cục (Global Hotkey)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="Nhấn tổ hợp phím này bất kỳ lúc nào trên Windows (ngay cả khi ứng dụng đang chạy nền) để mở công cụ chọn vùng màn hình kiểu Snipping Tool."
                                                   Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Hotkey Display Badge -->
                                            <Border Grid.Column="0" Background="#131B2E" BorderBrush="{StaticResource AccentPurple}" BorderThickness="1.5" CornerRadius="8" Padding="16,8" Margin="0,0,14,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="Phím tắt hiện tại: " Foreground="{StaticResource TextSecondary}" FontSize="13" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding HotkeyDisplayText}" Foreground="#FFFFFF" FontSize="15" FontWeight="Bold" Margin="4,0,0,0" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Action Buttons -->
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <Button Command="{Binding StartRecordHotkeyCommand}"
                                                        Style="{StaticResource PurpleActionButton}"
                                                        Padding="16,8" Height="36" Margin="0,0,8,0">
                                                    <TextBlock Text="Thay đổi phím tắt" Foreground="#FFFFFF" FontWeight="SemiBold" FontSize="12.5" />
                                                </Button>

                                                <Button Command="{Binding ResetDefaultHotkeyCommand}"
                                                        Style="{StaticResource SecondaryDarkButton}"
                                                        Padding="14,8" Height="36" Margin="0,0,8,0">
                                                    <TextBlock Text="Khôi phục mặc định" FontSize="12.5" />
                                                </Button>

                                                <!-- Cancel Recording Button (visible only when recording) -->
                                                <Button Command="{Binding CancelRecordHotkeyCommand}"
                                                        Padding="12,8" Height="36">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource StopDangerButton}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRecordingHotkey}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <TextBlock Text="✕ Hủy" FontSize="12.5" FontWeight="SemiBold" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Hotkey Feedback Message -->
                                        <TextBlock Text="{Binding HotkeyStatusMessage}" FontSize="13" FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource AccentGreen}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsHotkeyError}" Value="True">
                                                            <Setter Property="Foreground" Value="{StaticResource AccentRed}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>

                                <!-- Section 1B: Quick Translate & Windows Background Operation -->
                                <Border Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Dịch tức thì &amp; Chạy nền (Quick Translate &amp; Tray)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="Cho phép ứng dụng chạy ẩn dưới khay hệ thống và tự động dịch ngay trên video khi quét chọn vùng, không cần mở lại Dashboard."
                                                   Foreground="{StaticResource TextMuted}" FontSize="12.5" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <!-- Toggle: Quick Translate Mode -->
                                        <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                                  Content="Chế độ dịch tức thì (Quick Translate Mode) — Tự động bắt đầu dịch ngay sau khi chọn vùng"
                                                  IsChecked="{Binding QuickTranslateMode}" Margin="0,0,0,10" />

                                        <!-- Toggle: Minimize to Tray on Close -->
                                        <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                                  Content="Thu nhỏ xuống khay hệ thống (System Tray) khi đóng cửa sổ Dashboard"
                                                  IsChecked="{Binding MinimizeToTrayOnClose}" Margin="0,0,0,10" />

                                        <!-- Toggle: Auto-position Overlay near Region -->
                                        <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                                  Content="Tự động căn chỉnh vị trí phụ đề nổi (Overlay) ngay cạnh vùng vừa quét"
                                                  IsChecked="{Binding AutoPositionOverlayNearRegion}" Margin="0,0,0,4" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: Online AI Translator (Azure / Gemini Contextual AI) -->
                                <Border Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="🌐 Dịch thuật AI Trực tuyến (Azure Translator &amp; Gemini Contextual AI)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="Thông tin API Key được mã hóa an toàn trên Windows bằng DPAPI (ProtectedData), không lưu dưới dạng văn bản thuần." Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,14" />

                                        <!-- Online AI Provider Selector -->
                                        <TextBlock Text="Nhà cung cấp Online AI ưu tiên" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <ComboBox Style="{StaticResource ModernComboBox}" SelectedIndex="{Binding OnlineProviderIndex, Mode=TwoWay}" Margin="0,0,0,14">
                                            <ComboBoxItem Content="🌐 Azure AI Translator (Tốc độ cao, ổn định)" />
                                            <ComboBoxItem Content="✨ Gemini Contextual AI (Dịch hội thoại tự nhiên theo ngữ cảnh trước)" />
                                        </ComboBox>

                                        <!-- Azure API Key -->
                                        <TextBlock Text="Azure Translator API Key" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding AzureApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{StaticResource BgSidebar}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}"
                                                 Padding="10,8" FontSize="13" Margin="0,0,0,12" />

                                        <!-- Azure Region -->
                                        <TextBlock Text="Azure Region (Ví dụ: eastasia, southeastasia — để trống hoặc 'global' nếu dùng tài nguyên Global)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding AzureRegion, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{StaticResource BgSidebar}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}"
                                                 Padding="10,8" FontSize="13" Margin="0,0,0,12" />

                                        <!-- Azure Endpoint -->
                                        <TextBlock Text="Azure Endpoint URL (Mặc định: https://api.cognitive.microsofttranslator.com)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding AzureEndpoint, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{StaticResource BgSidebar}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}"
                                                 Padding="10,8" FontSize="13" Margin="0,0,0,14" />

                                        <!-- Gemini API Key -->
                                        <TextBlock Text="Gemini API Key (Dùng khi chọn Gemini Contextual AI)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding GeminiApiKey, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{StaticResource BgSidebar}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}"
                                                 Padding="10,8" FontSize="13" Margin="0,0,0,12" />

                                        <!-- Gemini Model -->
                                        <TextBlock Text="Gemini Model (Mặc định: gemini-2.5-flash)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBox Text="{Binding GeminiModel, UpdateSourceTrigger=PropertyChanged}"
                                                 Background="{StaticResource BgSidebar}" Foreground="#FFFFFF" BorderBrush="{StaticResource BorderBrushDark}"
                                                 Padding="10,8" FontSize="13" Margin="0,0,0,14" />

                                        <!-- Context-Aware Toggle -->
                                        <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                                  Content="Dịch theo ngữ cảnh hội thoại trước đó (Context-Aware — giúp giữ đúng đại từ và văn phong)"
                                                  IsChecked="{Binding EnableContextAwareTranslation}" Margin="0,0,0,10" />

                                        <!-- Test Connection Row -->
                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,12">
                                            <Button Command="{Binding TestOnlineConnectionCommand}"
                                                    Style="{StaticResource SecondaryDarkButton}"
                                                    Padding="14,8" Margin="0,0,12,0">
                                                <TextBlock Text="🔌 Kiểm tra kết nối Online API" FontSize="12.5" FontWeight="SemiBold" />
                                            </Button>
                                            <TextBlock Text="{Binding ConnectionTestMessage}" VerticalAlignment="Center" FontSize="12.5" TextWrapping="Wrap" MaxWidth="480">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{StaticResource AccentAmber}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsConnectionTestSuccess}" Value="True">
                                                                <Setter Property="Foreground" Value="{StaticResource AccentGreen}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>

                                        <!-- Use Mock Translation Checkbox -->
                                        <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                                  Content="Sử dụng Mock Translation (Chế độ Thử nghiệm offline không cần API Key)"
                                                  IsChecked="{Binding UseMockTranslation}" Margin="0,4,0,4" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 3: PaddleOCR Settings -->
                                <Border Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="🖥 Nhận diện chữ (PaddleOCR Worker)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="PaddleOCR hoạt động độc lập qua tiến trình worker nền, hỗ trợ chữ Tiếng Anh, Tiếng Trung và Tiếng Việt." Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,14" />

                                        <TextBlock Text="Tiến trình Python: python (Python 3.10+ x64)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,6" />
                                        <TextBlock Text="Script Worker: workers/paddle-ocr/ocr_worker.py" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,10" />
                                    </StackPanel>
                                </Border>

                                <!-- Section: Chế độ Dịch & Chính sách Fallback (Phase 9) -->
                                <Border Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="🛡️ Chế độ Dịch &amp; Chính sách Fallback (Quyền riêng tư)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="Cấu hình mức độ bảo mật dữ liệu, cho phép hoạt động 100% Offline không gửi phụ đề lên Cloud." Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,14" />

                                        <CheckBox Style="{StaticResource ModernToggleSwitch}"
                                                  Content="Cho phép tự động fallback sang Azure Cloud khi Offline AI gặp lỗi (Mặc định: Tắt để bảo vệ quyền riêng tư)"
                                                  IsChecked="{Binding AllowCloudFallbackOnOfflineFailure}" Margin="0,4,0,4" />
                                    </StackPanel>
                                </Border>

                                <!-- Section: Tăng tốc Phần cứng & GPU (Hardware Diagnostics - Phase 9) -->
                                <Border Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <TextBlock Text="⚡ Tăng tốc Phần cứng &amp; Hiệu năng Windows (GPU Acceleration)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" Margin="0,0,0,6" />
                                        <TextBlock Text="Thông tin phần cứng tự động phát hiện trên máy tính và cấu hình profile xử lý AI." Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,14" />

                                        <Grid Margin="0,0,0,14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- CPU Info -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="VI XỬ LÝ (CPU)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding CpuInfoText}" Foreground="#38BDF8" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- GPU Info -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="CARD ĐỒ HỌA (GPU)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding GpuInfoText}" Foreground="#34D399" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- RAM Info -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="BỘ NHỚ RAM" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding RamInfoText}" Foreground="#FBBF24" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Disk Info -->
                                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="DUNG LƯỢNG Ổ ĐĨA KHẢ DỤNG" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding FreeDiskSpaceText}" Foreground="#A78BFA" FontSize="13" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <!-- Profile Buttons -->
                                        <TextBlock Text="Hồ sơ hiệu năng (Performance Profile)" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <Button Command="{Binding SetPerformanceProfileCommand}"
                                                    CommandParameter="{x:Static enums:OverallPerformanceProfile.Fast}"
                                                    Style="{StaticResource SecondaryDarkButton}" Padding="16,8" Margin="0,0,8,0">
                                                <TextBlock Text="🚀 Fast (Tiết kiệm Pin / CPU yếu)" FontSize="12.5" />
                                            </Button>
                                            <Button Command="{Binding SetPerformanceProfileCommand}"
                                                    CommandParameter="{x:Static enums:OverallPerformanceProfile.Balanced}"
                                                    Style="{StaticResource PurpleActionButton}" Padding="16,8" Margin="0,0,8,0">
                                                <TextBlock Text="⚖ Balanced (Cân bằng — Mặc định)" FontSize="12.5" Foreground="#FFFFFF" />
                                            </Button>
                                            <Button Command="{Binding SetPerformanceProfileCommand}"
                                                    CommandParameter="{x:Static enums:OverallPerformanceProfile.Quality}"
                                                    Style="{StaticResource SecondaryDarkButton}" Padding="16,8">
                                                <TextBlock Text="💎 Quality (Chất lượng cao nhất)" FontSize="12.5" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Section: Quản lý Mô hình AI Cục bộ (AI Model Manager - Phase 9) -->
                                <Border Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,18">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="🧠 Quản lý Mô hình AI Cục bộ (AI Model Manager)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <Border CornerRadius="3" Padding="6,2" Margin="10,0,0,0" Background="#1E293B">
                                                <TextBlock Text="Offline Models" Foreground="#34D399" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Quản lý và kích hoạt các mô hình OCR, nhận diện giọng nói và dịch thuật offline trên máy." Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,14" />

                                        <TextBlock Text="Thư mục lưu trữ mô hình AI:" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,0,0,4" />
                                        <TextBox Text="{Binding ModelStorageDirectory, Mode=OneWay}" IsReadOnly="True"
                                                 Background="{StaticResource BgSidebar}" Foreground="#94A3B8" BorderBrush="{StaticResource BorderBrushDark}"
                                                 Padding="10,8" FontSize="12" Margin="0,0,0,14" />

                                        <!-- Model List -->
                                        <ItemsControl ItemsSource="{Binding Models}" Margin="0,0,0,10">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,8">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding Name}" Foreground="#FFFFFF" FontSize="13.5" FontWeight="SemiBold" />
                                                                    <Border CornerRadius="4" Padding="5,1" Margin="8,0,0,0" Background="#1E293B">
                                                                        <TextBlock Text="{Binding Category}" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
                                                                    </Border>
                                                                    <Border CornerRadius="4" Padding="5,1" Margin="6,0,0,0" Background="#0F2D1F">
                                                                        <TextBlock Text="{Binding QuantizationType}" Foreground="#34D399" FontSize="10" FontWeight="Bold" />
                                                                    </Border>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding SupportedLanguages, StringFormat='Ngôn ngữ: {0}'}" Foreground="{StaticResource TextMuted}" FontSize="12" Margin="0,3,0,0" />
                                                                <TextBlock Text="{Binding FormattedSize, StringFormat='Kích thước: {0}'}" Foreground="{StaticResource TextMuted}" FontSize="11.5" Margin="0,1,0,0" />
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Border CornerRadius="4" Padding="8,4" Margin="0,0,8,0" Background="#1E293B">
                                                                    <TextBlock Text="{Binding Status}" Foreground="#FBBF24" FontSize="11" FontWeight="Bold" />
                                                                </Border>

                                                                <Button Command="{Binding DataContext.ActivateModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource PurpleActionButton}"
                                                                        Padding="10,6" Height="30" Margin="0,0,6,0" ToolTip="Kích hoạt mô hình này">
                                                                    <TextBlock Text="Kích hoạt" FontSize="11" Foreground="#FFFFFF" />
                                                                </Button>

                                                                <Button Command="{Binding DataContext.VerifyModelCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource SecondaryDarkButton}"
                                                                        Padding="8,6" Height="30" Margin="0,0,6,0" ToolTip="Kiểm tra tính toàn vẹn SHA-256">
                                                                    <TextBlock Text="Xác minh" FontSize="11" />
                                                                </Button>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Text="{Binding ModelActionMessage}" Foreground="{StaticResource AccentGreen}" FontSize="12.5" FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>

                                <!-- Section 4: Realtime Diagnostics -->
                                <Border Background="{StaticResource BgCardElevated}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="10" Padding="18" Margin="0,0,0,24">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="📊 Thông số hiệu năng hệ thống (Realtime Diagnostics)" FontSize="15" FontWeight="SemiBold" Foreground="#FFFFFF" />
                                            <Border CornerRadius="3" Padding="6,2" Margin="10,0,0,0" Background="#1E293B">
                                                <TextBlock Text="Phase 7 Live Metrics" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="Các chỉ số đo kiểm tra độ trễ thực tế qua từng giai đoạn xử lý, không sử dụng dữ liệu giả lập." Foreground="{StaticResource TextMuted}" FontSize="12.5" Margin="0,0,0,14" />

                                        <!-- Metrics Grid -->
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <!-- Card 1: Capture FPS -->
                                            <Border Grid.Row="0" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="CAPTURE FPS" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding CaptureFpsText}" Foreground="#38BDF8" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 2: OCR Time -->
                                            <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="THỜI GIAN OCR" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding OcrLatencyText}" Foreground="#A78BFA" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 3: Translation Time -->
                                            <Border Grid.Row="0" Grid.Column="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,8">
                                                <StackPanel>
                                                    <TextBlock Text="THỜI GIAN DỊCH (API)" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding TranslationLatencyText}" Foreground="#FBBF24" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 4: End to End -->
                                            <Border Grid.Row="0" Grid.Column="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                                                <StackPanel>
                                                    <TextBlock Text="ĐỘ TRỄ END-TO-END" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding EndToEndLatencyText}" Foreground="#34D399" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 5: Cache Hit Rate -->
                                            <Border Grid.Row="1" Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="CACHE HIT RATE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding CacheHitRateText}" Foreground="#F472B6" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 6: OCR Queue -->
                                            <Border Grid.Row="1" Grid.Column="1" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,8,0">
                                                <StackPanel>
                                                    <TextBlock Text="OCR QUEUE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding OcrQueueLengthText}" Foreground="#F8FAFC" FontSize="15" FontWeight="Bold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>

                                            <!-- Card 7: Pipeline State -->
                                            <Border Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="8" Padding="12,10">
                                                <StackPanel>
                                                    <TextBlock Text="TRẠNG THÁI PIPELINE" Foreground="{StaticResource TextMuted}" FontSize="10" FontWeight="Bold" />
                                                    <TextBlock Text="{Binding PipelineStatusText}" Foreground="#38BDF8" FontSize="14" FontWeight="SemiBold" Margin="0,2,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Save Buttons Row -->
                                <StackPanel Orientation="Horizontal">
                                    <Button Command="{Binding SaveSettingsCommand}"
                                            Style="{StaticResource PurpleActionButton}"
                                            Padding="22,10" Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="💾 " Foreground="#FFFFFF" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Text="Lưu cài đặt" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13.5" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>

                                    <Button Command="{Binding NavigateCommand}" CommandParameter="Dashboard"
                                            Style="{StaticResource SecondaryDarkButton}"
                                            Padding="18,10" Margin="0,0,14,0">
                                        <TextBlock Text="Quay lại Dashboard" FontSize="13" />
                                    </Button>

                                    <TextBlock Text="{Binding SettingsSaveMessage}" Foreground="{StaticResource AccentGreen}"
                                               FontSize="13.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
