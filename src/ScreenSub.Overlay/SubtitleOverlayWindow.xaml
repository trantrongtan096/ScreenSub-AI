<Window x:Class="ScreenSub.Overlay.SubtitleOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenSub AI Overlay"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowActivated="False"
        ShowInTaskbar="False"
        SizeToContent="Height"
        MinWidth="400"
        MaxWidth="1600"
        Loaded="OnLoaded"
        MouseDown="OnMouseDown"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        RenderOptions.ClearTypeHint="Enabled">

    <Window.Resources>
        <FontFamily x:Key="OverlayFont">Segoe UI Variable Display, Segoe UI, Microsoft YaHei UI, PingFang SC, Arial, sans-serif</FontFamily>

        <LinearGradientBrush x:Key="OverlayBorderBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#408B5CF6" Offset="0.0" />
            <GradientStop Color="#406366F1" Offset="0.5" />
            <GradientStop Color="#4038BDF8" Offset="1.0" />
        </LinearGradientBrush>
    </Window.Resources>

    <Grid Margin="12">
        <Border x:Name="OverlayContainer"
                BorderBrush="{StaticResource OverlayBorderBrush}"
                BorderThickness="1"
                CornerRadius="18"
                Padding="28,14"
                HorizontalAlignment="Center">

            <StackPanel HorizontalAlignment="Center">
                <!-- Edit Mode Drag Banner -->
                <Border x:Name="EditModeBanner"
                        Background="#7C3AED"
                        CornerRadius="8"
                        Padding="12,5"
                        Margin="0,0,0,10"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                    <TextBlock Text="✥ KÉO THẢ ĐỂ DI CHUYỂN PHỤ ĐỀ • NHẤN 'KHÓA VỊ TRÍ' KHI XONG"
                               Foreground="#FFFFFF"
                               FontSize="11.5"
                               FontWeight="SemiBold"
                               FontFamily="{StaticResource OverlayFont}"
                               HorizontalAlignment="Center" />
                </Border>

                <!-- Line 1: Source Language Text -->
                <TextBlock x:Name="OriginalTextBlock"
                           Text=""
                           Foreground="#CBD5E1"
                           FontSize="18"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource OverlayFont}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,2,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Opacity="0.95" Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Line 2: Secondary Target (English/Chinese) -->
                <TextBlock x:Name="EnglishTextBlock"
                           Text=""
                           Foreground="#FDE047"
                           FontSize="22"
                           FontWeight="SemiBold"
                           FontFamily="{StaticResource OverlayFont}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,2,0,4">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Opacity="0.95" Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>

                <!-- Line 3: Primary Target Translation (Vietnamese) -->
                <TextBlock x:Name="VietnameseTextBlock"
                           Text=""
                           Foreground="#FFFFFF"
                           FontSize="26"
                           FontWeight="Bold"
                           FontFamily="{StaticResource OverlayFont}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,2,0,2">
                    <TextBlock.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1.5" Opacity="0.95" Color="#000000" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>
        </Border>
    </Grid>
</Window>

