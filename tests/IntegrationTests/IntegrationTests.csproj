<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="FluentAssertions" Version="8.11.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.0" />
    <PackageReference Include="Moq" Version="4.21.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ScreenSub.Core\ScreenSub.Core.csproj" />
    <ProjectReference Include="..\..\src\ScreenSub.Infrastructure\ScreenSub.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\ScreenSub.Translation\ScreenSub.Translation.csproj" />
    <ProjectReference Include="..\..\src\ScreenSub.Capture\ScreenSub.Capture.csproj" />
    <ProjectReference Include="..\..\src\ScreenSub.Ocr\ScreenSub.Ocr.csproj" />
    <ProjectReference Include="..\..\src\ScreenSub.Audio\ScreenSub.Audio.csproj" />
    <ProjectReference Include="..\..\src\ScreenSub.Speech\ScreenSub.Speech.csproj" />
    <ProjectReference Include="..\..\src\ScreenSub.Desktop\ScreenSub.Desktop.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\test_assets\**" CopyToOutputDirectory="PreserveNewest" Link="test_assets\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
